# SCRIPT2 configuration
# Копируйте в .env и заполните реальными значениями

# База данных (роль script2 с минимальными правами)
DATABASE_URL=postgresql://script2:PASSWORD@host.docker.internal:5432/hosts

# Воркер
WORKER_ID=
CONCURRENCY=100
BATCH_SIZE=50
DB_POOL_SIZE=10

# Таймауты (секунды)
CHECK_TIMEOUT=10
LEASE_SECONDS=300
SHUTDOWN_TIMEOUT=30

# Retry
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=30

# Polling
POLL_INTERVAL=5
REAPER_INTERVAL=60
USE_NOTIFY=false

# Proxy (один из вариантов)
PROXY_FILE=/app/proxies.txt
PROXY_URL=

# Health & Logging
HEARTBEAT_FILE=/tmp/heartbeat
LOG_LEVEL=INFO
